# Backend REST API base URL (required for auth, workspaces, messages history)
VITE_BACKEND_API_URL=https://your-backend.onrender.com/api

# Backend Socket.IO server URL (required for realtime send/receive).
# If this is missing or wrong, messages are queued but NEVER delivered live.
VITE_BACKEND_SOCKET_URL=https://your-backend.onrender.com

# Cloudinary uploads (required for images + voice notes).
# These must be the UNSIGNED upload preset's cloud name and preset name.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_PRESET_NAME=your-unsigned-upload-preset

# PeerJS server (required for video/voice calls)
VITE_PEERJS_HOST=0.peerjs.com
VITE_PEERJS_PORT=443
VITE_PEERJS_PATH=/